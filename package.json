{
  "name": "gdx",
  "version": "0.4.6",
  "description": "Git, but with better DX. The raw power of Git, aligned with human workflows.",
  "homepage": "https://github.com/Type-Delta/gdx#readme",
  "bugs": {
    "url": "https://github.com/Type-Delta/gdx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Type-Delta/gdx.git"
  },
  "keywords": [
    "git",
    "dx",
    "cli-wrapper"
  ],
  "license": "MIT",
  "author": "Type-Delta",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gdx": "scripts/launcher.cjs"
  },
  "files": [
    "dist/*.js",
    "dist/workers/*.js",
    "scripts/postinstall.cjs",
    "scripts/launcher.cjs",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.3.10",
  "scripts": {
    "prepare-dev": "bun i && bun run transpile-esm",
    "start": "bun run src/index.ts",
    "start:profile": "bun --cpu-prof src/index.ts",
    "start:node": "tsx src/index.ts",
    "transpile-esm": "bunx tsc -p lib/tsconfig.json && bun run scripts/transform-tools.mjs",
    "check": "bun run ts-check && bun run lint && bun run build",
    "lint": "bun run ts-check && eslint src --ext .ts -c eslint.config.ts --fix",
    "test": "bun test",
    "build": "bun run transpile-esm && bun build ./src/index.ts --outfile=./bin/gdx --compile --bytecode --production --keep-names",
    "ts-check": "bunx tsc --noEmit",
    "package:node": "bun run transpile-esm && bun build ./src/index.ts --outdir=./dist --target=node --external=keytar --external=cspell-lib --external=@shikijs/cli --external=shiki --external=yaml --external=openai --external=fflate --external=diff --format=esm --production --keep-names && bun build ./src/workers/generic.worker.ts --outfile=./dist/workers/generic.worker.min.js --target=node --external=@shikijs/cli --format=esm --production --minify --keep-names",
    "prepack": "bun run package:node",
    "postinstall": "node scripts/postinstall.cjs",
    "prettier": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"./*.md\"",
    "dummy-editor": "bun ./scripts/dummyEditor.mjs",
    "bench:litedent": "bun run ./test/benchmarks/litedent.bench.ts",
    "bench:git-config": "bun run ./test/benchmarks/git-config.bench.ts",
    "bench:strwrap": "bun run ./test/benchmarks/tools/strwrap.bench.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.4",
    "@sinclair/typebox": "^0.34.49",
    "@types/chai": "^5.2.3",
    "@types/ini": "^4.1.1",
    "@types/which": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "bun-types": "latest",
    "chai": "^6.2.2",
    "dedent": "^1.7.2",
    "eslint": "^10.4.0",
    "execa": "^9.6.1",
    "ini": "^7.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "smol-toml": "^1.6.1",
    "tinybench": "^6.0.2",
    "tsx": "^4.22.3",
    "tty-strings": "^1.5.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "unicode-animations": "^1.0.3",
    "which": "2.0.2"
  },
  "dependencies": {
    "@shikijs/cli": "^4.1.0",
    "cspell-lib": "10.0.0",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "keytar": "^7.9.0",
    "openai": "^6.38.0",
    "yaml": "^2.9.0"
  },
  "patchedDependencies": {
    "tty-strings@1.5.2": "patches/tty-strings@1.5.2.patch",
    "execa@9.6.1": "patches/execa@9.6.1.patch"
  }
}
